# Copiá este archivo a .env y cambiá TODAS las claves:  cp .env.example .env
# El .env no se sube a git (está en .gitignore).
# Para generar claves largas:  openssl rand -base64 18

# Zona horaria del servidor (horarios que muestra la web y la bitácora).
# Tiene que ser la misma que ZONA_HORARIA del firmware.
TZ=America/Argentina/Buenos_Aires

# Base de datos (solo accesible dentro de Docker)
POSTGRES_PASSWORD=cambiame-db

# Broker MQTT
MQTT_CLAVE_BACKEND=cambiame-backend
# Un usuario por módulo, con el formato id:clave separados por espacio.
# El id es el DISPOSITIVO del firmware; la clave va en MQTT_CLAVE del firmware.
MQTT_SALAS="sala1:cambiame-sala1 sala2:cambiame-sala2"
# 127.0.0.1 = solo accesible a través de Tailscale Funnel (recomendado).
MQTT_BIND=127.0.0.1
MQTT_PUERTO_HOST=1883

# Clave para entrar a la web (la pide una vez y la recuerda 30 días).
# Vacía = sin clave. Cambiarla cierra todas las sesiones abiertas.
WEB_CLAVE=cambiame-web

# Web. 8090 para no chocar con el 8080/8081 del sistema meteorológico.
# Para que SOLO se vea por Tailscale, poné la IP 100.x.y.z del servidor.
WEB_BIND=0.0.0.0
WEB_PUERTO=8090
