# Copiá este archivo a .env y cambiá TODAS las claves:  cp .env.example .env
# El .env no se sube a git (está en .gitignore).

# Zona horaria: la usan los horarios de luz y riego. Cambiala por la tuya.
TZ=America/Argentina/Buenos_Aires

# Identificador del ESP32. Tiene que coincidir con DISPOSITIVO en firmware/include/config.h
DISPOSITIVO=sala1

# Base de datos (solo accesible dentro de Docker)
POSTGRES_PASSWORD=cambiame-db

# Broker MQTT: un usuario para el backend y otro para el ESP32
MQTT_USUARIO_BACKEND=backend
MQTT_CLAVE_BACKEND=cambiame-backend
MQTT_USUARIO_ESP32=esp32
MQTT_CLAVE_ESP32=cambiame-esp32
MQTT_PUERTO_HOST=1883

# Web. 8090 para no chocar con el 8080/8081 del sistema meteorológico.
# WEB_BIND=0.0.0.0 escucha en todas las interfaces (LAN + Tailscale).
# Para que SOLO se vea por Tailscale, poné la IP 100.x.y.z del servidor.
WEB_BIND=0.0.0.0
WEB_PUERTO=8090
